# Copy to .env.local for local development; set the same values in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.

# Public site URL (used for emails, webhooks, checkout return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Force demo mode (labelled sample data, all writes and payments disabled) even when Supabase is set.
DEMO_MODE=false

# Stripe (primary) — use test-mode keys first. Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Square (fallback) — Developer Dashboard → your app → Credentials / Webhooks
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Shagannan Shenanigans <orders@your-domain.com>"
# Comma-separated staff addresses for new-order / custom-request alerts
ADMIN_NOTIFICATION_EMAILS=

# Protects /api/cron/release-reservations (Vercel Cron sends it automatically)
CRON_SECRET=
